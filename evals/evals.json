    {
      "id": 24,
      "eval_name": "PR update_squat",
      "prompt": "Today I squatted 80kg × 5, a new personal record",
      "assertions": [
        { "type": "contains", "value": "PR" },
        { "type": "contains", "value": "80" },
        { "type": "regex", "value": "(congratulations | new record | breakthrough)" }
      ],
      "files": []
    },
    {
      "id": 25,
      "eval_name": "Female cycle_menstrual-phase training",
      "prompt": "My period started. Can I still train today?",
      "assertions": [
