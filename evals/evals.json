      "assertions": [
        { "type": "contains", "value": "Analyst Ray" },
        { "type": "regex", "value": "(abnormal | concern | warning | confirm)" }
      ],
      "files": []
    },
    {
      "id": 20,
      "eval_name": "Role boundary_coach does not cross boundary",
      "prompt": "Coach Alex, how much protein should I eat today?",
      "assertions": [
        { "type": "contains", "value": "Dr. Mei" }
      ],
      "files": []
    },
    {
      "id": 21,
      "eval_name": "Role boundary_dietitian does not cross boundary",
      "prompt": "Dr. Mei, help me create a muscle-gain training plan",
      "assertions": [
        { "type": "contains", "value": "Coach Alex" }
      ],
      "files": []
    },
    {
      "id": 22,
      "eval_name": "Solar-term timeliness_Spring Equinox",
      "prompt": "How should I preserve health right now?",
      "context": "The current date is during the Spring Equinox solar term",
      "assertions": [
        { "type": "contains", "value": "Spring Equinox" },
        { "type": "regex", "value": "(nourish the liver | soothe the liver | spring)" }
      ],
      "files": []
    },
    {
      "id": 23,
      "eval_name": "Fitness test record_push-ups",
      "prompt": "I tested push-ups and can do a maximum of 25 reps",
      "assertions": [
        { "type": "contains", "value": "record" },
        { "type": "contains", "value": "25" },
        { "type": "contains", "value": "push-ups" }
      ],
      "files": []
