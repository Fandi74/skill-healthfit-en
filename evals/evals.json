      ],
      "files": []
    },
    {
      "id": 18,
      "eval_name": "Achievement system_consecutive training",
      "prompt": "I have already trained for 7 consecutive days",
      "assertions": [
        { "type": "contains", "value": "achievement" },
        { "type": "regex", "value": "(unlocked | congratulations | milestone)" }
      ],
      "files": []
    },
    {
      "id": 19,
      "eval_name": "Data anomaly_sudden weight drop",
      "prompt": "Record today's weight as 65kg",
